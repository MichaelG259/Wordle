<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/reveal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/c3label"
        android:layout_width="218dp"
        android:layout_height="41dp"
        android:text="Guess #3 Check:"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/g3label" />

    <TextView
        android:id="@+id/g3label"
        android:layout_width="218dp"
        android:layout_height="41dp"
        android:text="Guess #3:"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/c2label" />

    <TextView
        android:id="@+id/c3"
        android:layout_width="191dp"
        android:layout_height="41dp"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/g1label"
        app:layout_constraintTop_toBottomOf="@+id/g3" />

    <TextView
        android:id="@+id/g3"
        android:layout_width="193dp"
        android:layout_height="41dp"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/g1label"
        app:layout_constraintTop_toBottomOf="@+id/c2" />

    <TextView
        android:id="@+id/c2label"
        android:layout_width="218dp"
        android:layout_height="41dp"
        android:text="Guess #2 Check:"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/g2label" />

    <TextView
        android:id="@+id/g2"
        android:layout_width="193dp"
        android:layout_height="41dp"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/g1label"
        app:layout_constraintTop_toBottomOf="@+id/c1" />

    <TextView
        android:id="@+id/g2label"
        android:layout_width="218dp"
        android:layout_height="41dp"
        android:text="Guess #2:"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/c1label" />

    <TextView
        android:id="@+id/c2"
        android:layout_width="193dp"
        android:layout_height="41dp"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/g1label"
        app:layout_constraintTop_toBottomOf="@+id/g2" />

    <Button
        android:id="@+id/guessButton"
        android:layout_width="134dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="52dp"
        android:scaleX="1"
        android:scaleY="1"
        android:text="Guess"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/enterGuess"
        android:layout_width="277dp"
        android:layout_height="53dp"
        android:layout_marginBottom="52dp"
        android:ems="10"
        android:inputType="text"
        android:text="Enter 4 letter guess here"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/revealLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:scaleX="2.5"
        android:scaleY="2.5"
        app:layout_constraintBottom_toTopOf="@+id/enterGuess"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/g1label"
        android:layout_width="218dp"
        android:layout_height="41dp"
        android:layout_marginTop="40dp"
        android:text="Guess #1:"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/g1"
        android:layout_width="192dp"
        android:layout_height="41dp"
        android:layout_marginTop="40dp"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/g1label"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/c1label"
        android:layout_width="218dp"
        android:layout_height="41dp"
        android:text="Guess #1 Check:"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/g1label" />

    <TextView
        android:id="@+id/c1"
        android:layout_width="193dp"
        android:layout_height="41dp"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/g1label"
        app:layout_constraintTop_toBottomOf="@+id/g1" />

</androidx.constraintlayout.widget.ConstraintLayout>